#!/bin/bash

# Keep ~/.agents, Claude, Codex, and Antigravity skill dirs in sync with this repo.
# Each skill directory (must contain SKILL.md) is mirrored as a symlink.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SOURCE_DIR="${REPO_ROOT}/agents/skills"
DEST_DIRS=(
    "${HOME}/.agents/skills"
    "${HOME}/.claude/skills"
    "${HOME}/.codex/skills"
    "${HOME}/.gemini/config/skills"
)
LAUNCH_LABEL="com.mwamodo.sync-skills"
LAUNCH_PLIST="${HOME}/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
SYSTEMD_UNIT="sync-skills"

target_base_for_dest() {
    local dest="$1"
    local repo_rel dest_rel rest prefix=""

    if [ "${REPO_ROOT#"$HOME"/}" = "$REPO_ROOT" ] || [ "${dest#"$HOME"/}" = "$dest" ]; then
        printf '%s\n' "$SOURCE_DIR"
        return
    fi

    repo_rel="${REPO_ROOT#"$HOME"/}"
    dest_rel="${dest#"$HOME"/}"
    dest_rel="${dest_rel%/}"
    rest="$dest_rel"

    while [ -n "$rest" ]; do
        prefix="../${prefix}"
        case "$rest" in
            */*) rest="${rest#*/}" ;;
            *) rest="" ;;
        esac
    done

    printf '%s\n' "${prefix}${repo_rel}/agents/skills"
}

DRY_RUN=false
VERBOSE=false
WATCH=false
INSTALL_AGENT=false
UNINSTALL_AGENT=false

usage() {
    echo "Usage: $0 [-n] [-v] [--watch] [--install] [--uninstall]" >&2
    echo "  -n           dry run, show actions without executing" >&2
    echo "  -v           verbose output" >&2
    echo "  --watch      resync when ${SOURCE_DIR} changes" >&2
    echo "  --install    sync on add/remove: a LaunchAgent on macOS, a systemd user service on Linux" >&2
    echo "  --uninstall  stop and remove that LaunchAgent or service" >&2
}

log() {
    if [ "$VERBOSE" = true ]; then
        echo "$@"
    fi
}

is_our_link() {
    local name="$1" target="$2" target_base="$3"
    [ "$target" = "${target_base}/${name}" ] \
        || [ "$target" = "${SOURCE_DIR}/${name}" ] \
        || [ "$target" = "../../.agents/skills/${name}" ] \
        || [ "$target" = "${HOME}/.agents/skills/${name}" ]
}

list_skills() {
    local path name
    [ -d "$SOURCE_DIR" ] || return 0

    for path in "$SOURCE_DIR"/*; do
        [ -d "$path" ] || continue
        name="$(basename "$path")"
        [ -f "${path}/SKILL.md" ] || continue
        printf '%s\n' "$name"
    done
}

sync_dest() {
    local dest="$1"
    local target_base name path target expected

    target_base="$(target_base_for_dest "$dest")"

    if [ ! -d "$dest" ]; then
        log "Creating $dest"
        if [ "$DRY_RUN" = false ]; then
            mkdir -p "$dest"
        fi
    fi

    while IFS= read -r name; do
        [ -n "$name" ] || continue
        path="${dest}/${name}"
        expected="${target_base}/${name}"

        if [ -L "$path" ]; then
            target="$(readlink "$path")"
            if [ "$target" = "$expected" ]; then
                log "Already linked: $path"
                ALREADY=$((ALREADY + 1))
                continue
            fi

            if is_our_link "$name" "$target" "$target_base"; then
                log "Updating $path -> $expected"
                if [ "$DRY_RUN" = false ]; then
                    ln -sfn "$expected" "$path"
                fi
                echo "Updated: $path -> $expected"
                LINKED=$((LINKED + 1))
                continue
            fi

            echo "Skipped (symlink exists): $path -> $target" >&2
            SKIPPED=$((SKIPPED + 1))
            continue
        fi

        if [ -e "$path" ]; then
            echo "Skipped (exists): $path" >&2
            SKIPPED=$((SKIPPED + 1))
            continue
        fi

        log "ln -s $expected $path"
        if [ "$DRY_RUN" = false ]; then
            ln -s "$expected" "$path"
        fi
        echo "Linked: $path -> $expected"
        LINKED=$((LINKED + 1))
    done < <(list_skills)

    for path in "$dest"/*; do
        [ -L "$path" ] || continue
        name="$(basename "$path")"
        target="$(readlink "$path")"
        is_our_link "$name" "$target" "$target_base" || continue

        if [ -d "${SOURCE_DIR}/${name}" ] && [ -f "${SOURCE_DIR}/${name}/SKILL.md" ]; then
            continue
        fi

        log "Removing stale $path"
        if [ "$DRY_RUN" = false ]; then
            rm "$path"
        fi
        echo "Pruned: $path"
        PRUNED=$((PRUNED + 1))
    done
}

sync_all() {
    local dest

    if [ ! -d "$SOURCE_DIR" ]; then
        echo "Error: source '$SOURCE_DIR' does not exist" >&2
        exit 1
    fi

    LINKED=0
    ALREADY=0
    PRUNED=0
    SKIPPED=0

    for dest in "${DEST_DIRS[@]}"; do
        sync_dest "$dest"
    done

    echo "sync-skills: ${LINKED} linked, ${ALREADY} already, ${PRUNED} pruned, ${SKIPPED} skipped"
}

source_fingerprint() {
    # Directory names plus SKILL.md presence; enough to detect add/remove/rename.
    list_skills | sort
}

watch_loop() {
    local prev current

    sync_all
    prev="$(source_fingerprint)"

    if command -v fswatch >/dev/null 2>&1; then
        log "Watching $SOURCE_DIR with fswatch"
        fswatch -o -l 1 "$SOURCE_DIR" | while read -r _; do
            sync_all
        done
        return
    fi

    log "Watching $SOURCE_DIR by polling (install fswatch for event-based updates)"
    while true; do
        sleep 2
        current="$(source_fingerprint)"
        if [ "$current" != "$prev" ]; then
            sync_all
            prev="$current"
        fi
    done
}

write_launch_plist() {
    mkdir -p "$(dirname "$LAUNCH_PLIST")"
    cat > "$LAUNCH_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LAUNCH_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${SCRIPT_PATH}</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>${SOURCE_DIR}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${HOME}/Library/Logs/sync-skills.log</string>
    <key>StandardErrorPath</key>
    <string>${HOME}/Library/Logs/sync-skills.log</string>
</dict>
</plist>
EOF
}

install_launch_agent() {
    local domain
    domain="gui/$(id -u)"

    if [ "$DRY_RUN" = true ]; then
        echo "Would install LaunchAgent: $LAUNCH_PLIST"
        return 0
    fi

    write_launch_plist
    launchctl bootout "$domain" "$LAUNCH_PLIST" >/dev/null 2>&1 || true
    launchctl bootstrap "$domain" "$LAUNCH_PLIST"
    echo "Installed LaunchAgent: $LAUNCH_LABEL"
    echo "Watching $SOURCE_DIR (log: ${HOME}/Library/Logs/sync-skills.log)"
}

uninstall_launch_agent() {
    local domain
    domain="gui/$(id -u)"

    if [ "$DRY_RUN" = true ]; then
        echo "Would unload and remove $LAUNCH_PLIST"
        return 0
    fi

    launchctl bootout "$domain" "$LAUNCH_PLIST" >/dev/null 2>&1 || true
    rm -f "$LAUNCH_PLIST"
    echo "Removed LaunchAgent: $LAUNCH_LABEL"
}

# A systemd path unit drops changes made while a sync runs and misses a SKILL.md
# written after its folder, so on Linux a user service runs --watch instead.
write_systemd_unit() {
    mkdir -p "$SYSTEMD_DIR"
    cat > "${SYSTEMD_DIR}/${SYSTEMD_UNIT}.service" <<EOF
[Unit]
Description=Keep agent skill links in sync with ${SOURCE_DIR}

[Service]
ExecStart=/bin/bash "${SCRIPT_PATH}" --watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
}

install_systemd_unit() {
    if [ "$DRY_RUN" = true ]; then
        echo "Would install systemd user service: ${SYSTEMD_DIR}/${SYSTEMD_UNIT}.service"
        return 0
    fi

    write_systemd_unit
    systemctl --user daemon-reload
    systemctl --user enable "${SYSTEMD_UNIT}.service"
    systemctl --user restart "${SYSTEMD_UNIT}.service"
    echo "Installed systemd user service: ${SYSTEMD_UNIT}.service"
    echo "Watching $SOURCE_DIR (log: journalctl --user -u ${SYSTEMD_UNIT})"
}

uninstall_systemd_unit() {
    if [ "$DRY_RUN" = true ]; then
        echo "Would stop and remove ${SYSTEMD_DIR}/${SYSTEMD_UNIT}.service"
        return 0
    fi

    systemctl --user disable --now "${SYSTEMD_UNIT}.service" >/dev/null 2>&1 || true
    rm -f "${SYSTEMD_DIR}/${SYSTEMD_UNIT}.service"
    systemctl --user daemon-reload
    echo "Removed systemd user service: ${SYSTEMD_UNIT}.service"
}

install_agent() {
    case "$(uname -s)" in
        Darwin) install_launch_agent ;;
        Linux) install_systemd_unit ;;
        *) echo "Error: --install supports macOS and Linux only" >&2; exit 1 ;;
    esac
}

uninstall_agent() {
    case "$(uname -s)" in
        Darwin) uninstall_launch_agent ;;
        Linux) uninstall_systemd_unit ;;
        *) echo "Error: --uninstall supports macOS and Linux only" >&2; exit 1 ;;
    esac
}

while [ $# -gt 0 ]; do
    case "$1" in
        -n) DRY_RUN=true ;;
        -v) VERBOSE=true ;;
        --watch) WATCH=true ;;
        --install) INSTALL_AGENT=true ;;
        --uninstall) UNINSTALL_AGENT=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
    shift
done

if [ "$INSTALL_AGENT" = true ] && [ "$UNINSTALL_AGENT" = true ]; then
    echo "Error: --install and --uninstall cannot be used together" >&2
    exit 1
fi

if [ "$UNINSTALL_AGENT" = true ]; then
    uninstall_agent
    exit 0
fi

if [ "$INSTALL_AGENT" = true ]; then
    install_agent
    # The agent also syncs when it starts; sync here too so the terminal shows results.
    sync_all
    exit 0
fi

if [ "$WATCH" = true ]; then
    watch_loop
    exit 0
fi

sync_all
