#!/usr/bin/osascript -l JavaScript

// @tuna.name Maximize Window
// @tuna.subtitle Fill the current screen, leaving a small margin around the window
// @tuna.icon macwindow
// @tuna.mode background
// @tuna.input none
// @tuna.output none

// resize the focused window to fill whichever screen it is currently on,
// leaving a margin on every side. this is not native fullscreen, the window
// stays in the current space.
//
// usage: maximize-window [MARGIN]
// margin is in points. falls back to $WINDOW_MARGIN, then DEFAULT_MARGIN.
//
// needs Accessibility permission for the app that runs it
// (System Settings > Privacy & Security > Accessibility).

ObjC.import("AppKit");

const DEFAULT_MARGIN = 8;

function resolveMargin(argv) {
    const env = $.NSProcessInfo.processInfo.environment.objectForKey("WINDOW_MARGIN");
    const raw = argv.length > 0 ? argv[0] : ObjC.unwrap(env);
    if (!raw) return DEFAULT_MARGIN;

    const margin = Number(raw);
    if (!Number.isFinite(margin) || margin < 0) {
        throw new Error(`invalid margin '${raw}', expected a number >= 0`);
    }

    return Math.round(margin);
}

function focusedWindow(proc) {
    try {
        const win = proc.attributes.byName("AXFocusedWindow").value();
        if (win) return win;
    } catch (e) {
        // some apps don't expose AXFocusedWindow, fall through
    }
    return proc.windows.length > 0 ? proc.windows[0] : null;
}

// NSScreen has a bottom-left origin, Accessibility has a top-left one.
// Both are relative to the primary screen, so flip y using its height.
function visibleFrames() {
    const screens = $.NSScreen.screens;
    const primaryHeight = screens.objectAtIndex(0).frame.size.height;
    const frames = [];

    for (let i = 0; i < screens.count; i++) {
        const f = screens.objectAtIndex(i).visibleFrame;
        frames.push({
            x: f.origin.x,
            y: primaryHeight - (f.origin.y + f.size.height),
            w: f.size.width,
            h: f.size.height,
        });
    }

    return frames;
}

function run(argv) {
    const margin = resolveMargin(argv);
    const systemEvents = Application("System Events");
    const proc = systemEvents.applicationProcesses.whose({ frontmost: true })[0];
    const win = focusedWindow(proc);

    if (!win) return;

    try {
        if (win.attributes.byName("AXFullScreen").value()) return;
    } catch (e) {
        // not every window has AXFullScreen
    }

    const [x, y] = win.position();
    const [w, h] = win.size();
    const midX = x + w / 2;
    const midY = y + h / 2;

    const frames = visibleFrames();
    const screen =
        frames.find(
            (f) => midX >= f.x && midX < f.x + f.w && midY >= f.y && midY < f.y + f.h,
        ) || frames[0];

    const position = [Math.round(screen.x + margin), Math.round(screen.y + margin)];
    const size = [
        Math.round(Math.max(0, screen.w - margin * 2)),
        Math.round(Math.max(0, screen.h - margin * 2)),
    ];

    // macOS clamps a resize to what fits on screen from the window's current
    // position, so shrink-to-fit first, move, then apply the final size.
    win.size = size;
    win.position = position;
    win.size = size;
}
